# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://monikaluxeinteriors.com

# ---- Enquiry delivery (configure at least ONE) ----
# Option A — Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Monika Luxe Website <enquiries@monikaluxeinteriors.com>"
ENQUIRY_TO_EMAIL=

# Option B — Any HTTPS webhook (Google Apps Script, Zapier, Make, Formspree endpoint, your CRM…)
# Receives a JSON POST of the validated enquiry.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the "x-enquiry-secret" header to the webhook.
ENQUIRY_WEBHOOK_SECRET=
